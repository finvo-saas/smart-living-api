# Django
# Local: config.settings.dev | Production gunicorn/celery: config.settings.prod
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Production TLS (used by config.settings.prod)
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# If nginx already terminates TLS and redirects, set:
# SECURE_SSL_REDIRECT=false

# Database — prefer DB_* (local Postgres). Leave DB_NAME empty to use SQLite.
DB_NAME=smart_living_api
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Or use a single URL instead of DB_* (takes effect when DB_NAME is empty):
# DATABASE_URL=postgres://smartliving:smartliving@localhost:5432/smart_living

# Redis / Celery / hardening
# Dev: keep USE_REDIS_CACHE=false and CELERY_TASK_ALWAYS_EAGER=true so runserver
# never blocks waiting for Redis/broker. Flip for production workers.
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BEAT_ENABLED=false
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
API_THROTTLING_ENABLED=false
OTP_RATE_LIMIT_ENABLED=true
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
# THROTTLE_ANON=180/minute
# THROTTLE_USER=600/minute
# THROTTLE_OTP=5/hour

# JWT + session cookies
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
# Lax works when the browser page and API are same-site (localhost + localhost).
# Different hosts (app vs api) need AUTH_COOKIE_SAMESITE=None and HTTPS.
AUTH_COOKIE_SAMESITE=Lax
AUTH_COOKIE_SECURE=false
AUTH_DEVICE_TTL_DAYS=90

# DigitalOcean Spaces (preferred). Files land under STORAGE_ROOT_FOLDER/ in the
# bucket, one subfolder per product area: property/, mess/, hotels/, users/,
# media/bills/, notices/, support/, chat/, documents/, verification/.
# Application code always uses media_storage — swap provider here, not in views.
# AWS S3 later: leave DO_SPACES_* empty and set AWS_ACCESS_KEY_ID / SECRET /
# BUCKET / REGION (no endpoint). MinIO: point AWS_S3_ENDPOINT_URL at MinIO.
# STORAGE_PROVIDER=local forces the local filesystem even if keys are present.
STORAGE_PROVIDER=digitalocean
STORAGE_ROOT_FOLDER=smart-living-system
DO_SPACES_KEY=
DO_SPACES_SECRET=
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_REGION=sgp1
DO_SPACES_BUCKET=
# CDN URL for public reads (optional). Falls back to DO_SPACES_URL (origin).
DO_SPACES_CDN_URL=
DO_SPACES_URL=

# Fallback only when DO_* is empty (local MinIO — see docker-compose.yml)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=smart-living-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

# SMS — BulkSMS BD. senderid MUST be an Approved ID from the portal
# (masking name e.g. MyShop, or non-masking number e.g. 88096…).
# Error 1005 / is_masking on null = wrong or unapproved sender id.
# Error 1032 = whitelist your public IP under Phonebook → IP White List.
# SMS — platform BulkSMSBD (owners use system credits; no owner API keys)
SMS_PROVIDER=bulksmsbd
SMS_SENDER_ID=
BULKSMSBD_API_KEY=
BULKSMSBD_API_SECRET=
BULKSMSBD_API_URL=https://bulksmsbd.net/api/smsapi
BULKSMSBD_API_SENDER=
BULKSMSBD_API_SENDER_ID=
# Monthly free SMS by subscription tier
SMS_FREE_QUOTA_FREE=20
SMS_FREE_QUOTA_BASIC=100
SMS_FREE_QUOTA_PREMIUM=500
SMS_CREDIT_UNIT_PRICE_BDT=0.50
# SMS_PROVIDER=console     # log-only fallback when the gateway is down
# Vacancy heartbeat SMS (admin UI also has a switch; BOTH must be on to send)
HEARTBEAT_SMS_ENABLED=false
# Web Push (python manage.py generate_vapid_keys)
PUSH_ENABLED=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourdomain.com

# Email — console (dev) or smtp (set EMAIL_HOST / EMAIL_HOST_USER / etc.)
EMAIL_PROVIDER=console
EMAIL_NOTIFY_ENABLED=true
SMS_NOTIFY_ENABLED=false
DEFAULT_FROM_EMAIL=Smart Living <noreply@smartliving.local>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=true

# AI matching LLM (optional — rules always work as fallback)
AI_MATCH_LLM_ENABLED=false
AI_MATCH_LLM_API_KEY=
AI_MATCH_LLM_BASE_URL=https://api.openai.com/v1
AI_MATCH_LLM_MODEL=gpt-4o-mini

# CIMS gate on booking
CIMS_ENFORCE_BOOKING=true

# Geocoding — nominatim (free) | mapbox | google
GEOCODER_PROVIDER=nominatim
GEOCODER_CONTACT_EMAIL=support@yourdomain.com
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Fixed OTP only when SMS_PROVIDER=console (empty = always random)
# Live BulkSMSBD never returns the code to the browser.
OTP_DEV_FIXED_CODE=
OTP_SMS_PREFIX=SmartLiving

# Payments — never enable sandbox auto-complete in production
# Production (config.settings.prod) forces this off unless ALLOW_PAYMENT_SANDBOX_IN_PROD=true
PAYMENT_SANDBOX_AUTO_COMPLETE=true
# ALLOW_PAYMENT_SANDBOX_IN_PROD=false
FRONTEND_URL=http://localhost:3000
# Absolute API base including /api/v1 — used for branded public bill PDF links
# e.g. https://api.smartbasa.com/api/v1/public/bills/<property>/<file>.pdf
PUBLIC_API_URL=http://127.0.0.1:8000/api/v1
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_WEBHOOK_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://api.mynagad.com
ROCKET_MERCHANT_ID=
ROCKET_API_PASSWORD=
ROCKET_BASE_URL=https://sandbox.rocket.com.bd

# Platform
COMMISSION_RATE=0.05
DEFAULT_CURRENCY=BDT
