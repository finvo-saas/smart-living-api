# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database — prefer DB_* (local Postgres). Leave DB_NAME empty to use SQLite.
DB_NAME=smart_living_api
DB_USER=postgres
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=5432
# Or use a single URL instead of DB_* (takes effect when DB_NAME is empty):
# DATABASE_URL=postgres://smartliving:smartliving@localhost:5432/smart_living

# Redis / Celery / hardening
# Dev: keep USE_REDIS_CACHE=false and CELERY_TASK_ALWAYS_EAGER=true so runserver
# never blocks waiting for Redis/broker. Flip for production workers.
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BEAT_ENABLED=false
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
API_THROTTLING_ENABLED=false
OTP_RATE_LIMIT_ENABLED=true
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
# THROTTLE_ANON=60/hour
# THROTTLE_USER=1000/hour
# THROTTLE_OTP=5/hour

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Storage (MinIO local — see docker-compose.yml)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=smart-living-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

# SMS (dev stub)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=SmartLiving
# Fixed OTP in DEBUG only (empty = random code logged to console)
OTP_DEV_FIXED_CODE=123456

# Payments (sandbox — phase 4; replace with sandbox credentials)
PAYMENT_SANDBOX_AUTO_COMPLETE=true
FRONTEND_URL=http://localhost:3000
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_WEBHOOK_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://api.mynagad.com
ROCKET_MERCHANT_ID=
ROCKET_API_PASSWORD=
ROCKET_BASE_URL=https://sandbox.rocket.com.bd

# Platform
COMMISSION_RATE=0.05
DEFAULT_CURRENCY=BDT
