# Platform
COMMISSION_RATE=0.05
DEFAULT_CURRENCY=BDT
# OTP — fixed code ONLY for console SMS / local fallback (empty = random always)
# When SMS_PROVIDER=bulksmsbd succeeds, codes are always random and never returned to the UI.
OTP_DEV_FIXED_CODE=
OTP_SMS_PREFIX=SmartLiving
