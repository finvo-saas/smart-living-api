# Redis / Celery / hardening (dev-safe defaults — no hang without Redis)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BEAT_ENABLED=false
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
API_THROTTLING_ENABLED=false
OTP_RATE_LIMIT_ENABLED=true
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
# Production overrides (set when deploying):
# USE_REDIS_CACHE=true
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_BEAT_ENABLED=true
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# API_THROTTLING_ENABLED=true

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Unused when DO_* is set — DigitalOcean Spaces is the media backend
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=smart-living-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

# SMS — BulkSMS BD (SMS_PROVIDER=console to log only)
SMS_PROVIDER=bulksmsbd
SMS_API_KEY=

# Payments (sandbox — phase 4; replace with real sandbox credentials later)
