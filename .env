# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database (PostgreSQL — use docker-compose or local)

DB_NAME=smart_living_api
DB_USER=postgres
DB_PASSWORD=rafiq123
DB_HOST=localhost
DB_PORT=5432

# Redis / Celery / hardening (dev-safe defaults — no hang without Redis)
REDIS_URL=redis://localhost:6379/0
USE_REDIS_CACHE=false
CELERY_TASK_ALWAYS_EAGER=true
CELERY_BEAT_ENABLED=false
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
API_THROTTLING_ENABLED=false
OTP_RATE_LIMIT_ENABLED=true
OTP_RATE_LIMIT=5
OTP_RATE_WINDOW_SECONDS=3600
# Production overrides (set when deploying):
# USE_REDIS_CACHE=true
# CELERY_TASK_ALWAYS_EAGER=false
# CELERY_BEAT_ENABLED=true
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2
# API_THROTTLING_ENABLED=true

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Storage (MinIO local — see docker-compose.yml)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_STORAGE_BUCKET_NAME=smart-living-media
AWS_S3_ENDPOINT_URL=http://localhost:9000
AWS_S3_REGION_NAME=us-east-1
AWS_S3_USE_SSL=false

# SMS (dev stub)
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER_ID=SmartLiving

# Payments (sandbox — phase 4; replace with real sandbox credentials later)
PAYMENT_SANDBOX_AUTO_COMPLETE=true
FRONTEND_URL=http://localhost:3000
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_WEBHOOK_SECRET=
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_BASE_URL=https://api.mynagad.com
ROCKET_MERCHANT_ID=
ROCKET_API_PASSWORD=
ROCKET_BASE_URL=https://sandbox.rocket.com.bd

# Platform
COMMISSION_RATE=0.05
DEFAULT_CURRENCY=BDT
OTP_DEV_FIXED_CODE=123456
