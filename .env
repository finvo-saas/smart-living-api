#Digital Ocean Object Storage

DO_ACCESS_KEY=DO8019AAU7A8DXY6KF9M
DO_SECRET_KEY=kQ4BTzh3Bsty1myrRbosxH0MHNN0hBsFUEX9WOMjzaU
DO_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_REGION=sgp1
DO_BUCKET=finvostore-storage
ROOT_FOLDER=smart-living
